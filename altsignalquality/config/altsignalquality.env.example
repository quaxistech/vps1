# Production copy: /etc/altsignalquality/common.env (root:altsignalquality, 0640).
# Secrets live ONLY here, never in the repository or a release archive.
ALTSIGNALQUALITY_ENVIRONMENT=production
ALTSIGNALQUALITY_LOG_LEVEL=info
ALTSIGNALQUALITY_INSTANCE_ID=vps-1

# The `altsignalquality` schema lives INSIDE the shared AltSpotter database,
# next to the `altstrategy` schema: every read this service makes joins its own
# rows to AltStrategy's proposals, contexts and outcomes. A separate database
# would put postgres_fdw on the hot path of both inference and every training
# cycle.
ALTSIGNALQUALITY_POSTGRES_DSN=postgresql://altsignalquality_app:CHANGE_ME@127.0.0.1:5432/altspotter
ALTSIGNALQUALITY_NATS_URL=nats://altsignalquality_app:CHANGE_ME@127.0.0.1:4222

# --- one-time database bootstrap inputs (scripts/db-bootstrap.sh only; the
#     binary itself never reads these) ---
ALTSIGNALQUALITY_DB_NAME=altspotter
ALTSIGNALQUALITY_DB_USER=altsignalquality_app
ALTSIGNALQUALITY_DB_PASSWORD=CHANGE_ME
ALTSTRATEGY_SCHEMA=altstrategy

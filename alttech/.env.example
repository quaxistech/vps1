ALTTECH_ENVIRONMENT=production
ALTTECH_LOG_LEVEL=info
ALTTECH_INSTANCE_ID=alttech-1
ALTTECH_NATS_URL=nats://user:password@127.0.0.1:4222
# AltTech's own database (NOT altspotter's). It reads altspotter's public
# tables read-only through postgres_fdw foreign tables imported into this
# database's `public` schema; see docs/DATABASE.md.
ALTTECH_POSTGRES_DSN=postgresql://user:password@127.0.0.1:5432/alttech
# Shared by the service configuration and the topology checker, so the checked
# stream/consumer pair can never drift from the pair the service runs with.
ALTTECH_NATS_INPUT_STREAM=ALTSPOTTER_BARS
ALTTECH_NATS_OUTPUT_STREAM=ALTTECH_ANALYTICS
ALTTECH_NATS_DURABLE=alttech-bars
# Optional schema-only credentials. Leave empty to use the runtime DSN; a
# production deployment should use a least-privilege role that owns the
# `alttech` schema and has only SELECT on `public`.
ALTTECH_MIGRATION_DSN=

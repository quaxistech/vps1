# Production copy: /etc/altsignalgateway/common.env (root:altsignalgateway, 0640).
# Secrets live ONLY here, never in the repository, a release archive or a log.
ALTSIGNALGATEWAY_ENVIRONMENT=production
ALTSIGNALGATEWAY_LOG_LEVEL=info
ALTSIGNALGATEWAY_INSTANCE_ID=vps-1

# The `altsignalgateway` schema lives INSIDE the shared AltSpotter database,
# next to `altstrategy` and `altsignalquality`: every signal this service
# journals is enriched from AltStrategy's point-in-time context snapshot and
# AltSpotter's instrument registry. A separate database would put postgres_fdw
# on the hot path of every single signal.
ALTSIGNALGATEWAY_POSTGRES_DSN=postgresql://altsignalgateway_app:CHANGE_ME@127.0.0.1:5432/altspotter
ALTSIGNALGATEWAY_NATS_URL=nats://altsignalgateway_app:CHANGE_ME@127.0.0.1:4222

# --- WebSocket client keys ----------------------------------------------------
# One per entry in /etc/altsignalgateway/clients.yaml. Generate with:
#     openssl rand -hex 32
# 32 bytes minimum; the service refuses anything shorter.
ALTSIGNALGATEWAY_CLIENT_VPS2_SECRET=CHANGE_ME
ALTSIGNALGATEWAY_CLIENT_OBSERVER_SECRET=CHANGE_ME

# --- one-time bootstrap inputs (scripts/db-bootstrap.sh and scripts/nats-user.sh
#     only; the binary itself never reads these) ---
ALTSIGNALGATEWAY_DB_NAME=altspotter
ALTSIGNALGATEWAY_DB_USER=altsignalgateway_app
ALTSIGNALGATEWAY_DB_PASSWORD=CHANGE_ME
ALTSTRATEGY_SCHEMA=altstrategy
ALTSPOTTER_SCHEMA=public
ALTSIGNALGATEWAY_NATS_USER=altsignalgateway_app
ALTSIGNALGATEWAY_NATS_PASSWORD=CHANGE_ME

# Runtime secrets for altmacro. Installed at /etc/altmacro/altmacro.env with
# mode 0600, owned by the service user, and referenced by the systemd unit via
# EnvironmentFile. It is never committed and never printed.

ALTMACRO_DB_PASSWORD=

# nats://<user>:<password>@127.0.0.1:4222
ALTMACRO_NATS_URL=

# Only needed if a key-required provider is enabled in the YAML. Both are off
# by default and neither is required for any must-have instrument.
#ALTMACRO_TIINGO_TOKEN=
#ALTMACRO_TWELVEDATA_TOKEN=

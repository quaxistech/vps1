# Production copy: /etc/altml/common.env (root:altml, 0640).
ALTML_ENVIRONMENT=production
ALTML_LOG_LEVEL=info
ALTML_INSTANCE_ID=vps-1
# AltML's own dedicated database (schema `altml`); AltSpotter/AltTech data is
# reached read-only through postgres_fdw foreign tables inside it — see
# scripts/db-bootstrap.sh and db/schema.sql. Never point this at another
# service's database.
ALTML_POSTGRES_DSN=postgresql://altml_app:CHANGE_ME@127.0.0.1:5432/altml
ALTML_NATS_URL=nats://altml_app:CHANGE_ME@127.0.0.1:4222

# --- one-time database bootstrap inputs (scripts/db-bootstrap.sh only; not
#     read by the altml binary itself) ---
ALTML_DB_NAME=altml
ALTML_DB_USER=altml_app
ALTML_DB_PASSWORD=CHANGE_ME
ALTSPOTTER_FDW_HOST=127.0.0.1
ALTSPOTTER_FDW_PORT=5432
ALTSPOTTER_FDW_DBNAME=altspotter
ALTSPOTTER_FDW_USER=altml_reader
ALTSPOTTER_FDW_PASSWORD=CHANGE_ME
ALTTECH_FDW_HOST=127.0.0.1
ALTTECH_FDW_PORT=5432
ALTTECH_FDW_DBNAME=alttech
ALTTECH_FDW_USER=altml_reader
ALTTECH_FDW_PASSWORD=CHANGE_ME

